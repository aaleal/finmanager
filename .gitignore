# ---- Secrets & local config -------------------------------------------------
.env
.env.local
*.pem
dev/bootstrap-household.json
00.prompts/seed/Lego
00.prompts/seed/supermarket

# ---- The household's own files (ADR-0062) -----------------------------------
# Mounted at /var/lib/finmanager/defaults, never committed: the catalogue, the
# taxonomy workbook, the real talões, the LEGO collection and its box art are
# this household's data, not the product's. `data/README.md` documents the
# layout an install is expected to fill in.
/data/*
!/data/README.md

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
.venv/

# ---- Node -------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# Intermediate artefact of `make types-gen`; the generated src/api/schema.d.ts
# IS committed so `make check` works without a running API.
apps/web/openapi.json

# ---- Runtime data (docker named volumes are outside the tree, this is a guard)
storage/
*.log

# ---- Editors ----------------------------------------------------------------
.DS_Store
.idea/
*.swp
