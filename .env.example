# ---- Runtime ----------------------------------------------------------------
TZ=Europe/Lisbon
APP_ENV=development
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=finmanager
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=finmanager
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Security ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-replace-with-openssl-rand-hex-32
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# ---- Storage ----------------------------------------------------------------
# Attachment root, mounted outside the web root. Never served statically.
STORAGE_ROOT=/var/lib/finmanager/storage

# ---- Bootstrap owner (created by `make seed`) -------------------------------
BOOTSTRAP_OWNER_EMAIL=owner@finmanager.local
BOOTSTRAP_OWNER_PASSWORD=finmanager
BOOTSTRAP_HOUSEHOLD_NAME=Casa

# ---- External providers (all OFF by default) --------------------------------
# Brickset API key is stored in the Setting table, not here. This value is only
# used to pre-populate the setting on first seed.
BRICKSET_API_KEY=

# ---- Ports exposed on the host ----------------------------------------------
WEB_PORT=8080
API_PORT=8000
ADMINER_PORT=8081
