# ---- Runtime ----------------------------------------------------------------
TZ=Europe/Lisbon
APP_ENV=development
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------
POSTGRES_USER=finmanager
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=finmanager
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Security ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-key-replace-with-openssl-rand-hex-32
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# ---- Storage ----------------------------------------------------------------
# Attachment root, mounted outside the web root. Never served statically.
STORAGE_ROOT=/var/lib/finmanager/storage

# ---- Bootstrap ---------------------------------------------------------------
# There is none. A clean install has no users and no default password: the first
# screen asks you to create the household owner. See docs/decisions/0011-*.md.

# ---- External providers (all OFF by default) --------------------------------
# Set on a clean install (before the first boot) and Brickset switches itself on
# automatically — no visit to Definições needed (ADR-0038). Only takes effect
# once, on the boot that finds no Brickset Setting yet: a key or switch changed
# afterwards in Definições always outranks this value, so editing .env later
# does nothing until `make reset` starts the database over. Get a free key at
# brickset.com/tools/webservices/v3.
BRICKSET_API_KEY=

# ---- Ports exposed on the host ----------------------------------------------
WEB_PORT=8080
API_PORT=8000
ADMINER_PORT=8081
